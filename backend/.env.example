# Copy to backend/.env and fill in. Never commit the real .env.
APP_ENV=development
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_32_CHARS
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DEMO_MODE=true
# Passwords for the demo accounts created by the init script (admin/manager/analyst@supplychainx.demo)
DEMO_ADMIN_PASSWORD=
DEMO_MANAGER_PASSWORD=
DEMO_ANALYST_PASSWORD=
LOG_LEVEL=INFO
# Optional overrides of storage locations (defaults: backend/data, backend/datasets/sample, backend/artifacts)
# DATA_DIR=
# SAMPLE_DIR=
# ARTIFACTS_DIR=
