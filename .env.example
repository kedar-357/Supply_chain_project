# Used by docker-compose. Copy to .env next to docker-compose.yml.
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
DEMO_ADMIN_PASSWORD=change-me-Admin1
DEMO_MANAGER_PASSWORD=change-me-Manager1
DEMO_ANALYST_PASSWORD=change-me-Analyst1
# Train the forecasting + delay models on first start (~5 minutes)
SEED_TRAIN=true
